@model Inoc_laboratory.Models.User

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <title>Edit User</title>

    <link rel="icon"
          type="image/x-icon"
          href="/assets/favicon.ico" />

    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
            crossorigin="anonymous"></script>

    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700"
          rel="stylesheet"
          type="text/css" />

    <link href="https://fonts.googleapis.com/css?family=Lato:400,700,400italic,700italic"
          rel="stylesheet"
          type="text/css" />

    <link href="/css/styles.css"
          rel="stylesheet" />
</head>

<body id="page-top">

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg bg-secondary text-uppercase fixed-top"
         id="mainNav">

        <div class="container">

            <a class="navbar-brand"
               href="/Home/Index">
                Start Bootstrap
            </a>

            <button class="navbar-toggler text-uppercase font-weight-bold bg-primary text-white rounded"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarResponsive">

                Menu
                <i class="fas fa-bars"></i>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarResponsive">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item mx-0 mx-lg-1">

                        <a class="nav-link py-3 px-0 px-lg-3 rounded"
                           href="/Home/Index">
                            Home
                        </a>

                    </li>

                    <li class="nav-item mx-0 mx-lg-1">

                        <a class="nav-link py-3 px-0 px-lg-3 rounded"
                           href="/Home/register">
                            Register
                        </a>

                    </li>

                    <li class="nav-item mx-0 mx-lg-1">

                        <a class="nav-link py-3 px-0 px-lg-3 rounded"
                           href="/Home/login">
                            Login
                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- Header -->
    <header class="masthead bg-primary text-white text-center"
            style="padding-top: 10rem; padding-bottom: 6rem;">

        <div class="container d-flex align-items-center flex-column">

            <h1 class="masthead-heading text-uppercase mb-0">
                Edit User
            </h1>

            <div class="divider-custom divider-light">

                <div class="divider-custom-line"></div>

                <div class="divider-custom-icon">
                    <i class="fas fa-star"></i>
                </div>

                <div class="divider-custom-line"></div>

            </div>

        </div>

    </header>


    <!-- Edit Form -->
    <section class="page-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-6 col-xl-5">

                    <form id="editForm">

                        <!-- ID -->
                        <input type="hidden"
                               id="editId"
                               value="@Model.Id" />


                        <!-- Full Name -->
                        <div class="form-floating mb-3">

                            <input class="form-control"
                                   id="editFullName"
                                   type="text"
                                   value="@Model.FullName"
                                   placeholder="Full Name"
                                   required />

                            <label for="editFullName">
                                Full Name
                            </label>

                        </div>


                        <!-- Email -->
                        <div class="form-floating mb-3">

                            <input class="form-control"
                                   id="editEmail"
                                   type="email"
                                   value="@Model.Email"
                                   placeholder="Email"
                                   required />

                            <label for="editEmail">
                                Email
                            </label>

                        </div>


                        <!-- Username -->
                        <div class="form-floating mb-3">

                            <input class="form-control"
                                   id="editUsername"
                                   type="text"
                                   value="@Model.Username"
                                   placeholder="Username"
                                   required />

                            <label for="editUsername">
                                Username
                            </label>

                        </div>


                        <!-- Password -->
                        <div class="form-floating mb-3">

                            <input class="form-control"
                                   id="editPassword"
                                   type="password"
                                   value="@Model.Password"
                                   placeholder="Password"
                                   required />

                            <label for="editPassword">
                                Password
                            </label>

                        </div>


                        <!-- Update Button -->
                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-primary btn-xl">

                                Update User

                            </button>


                            <a href="/Home/Index"
                               class="btn btn-secondary btn-xl">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </section>


    <!-- JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="/js/auth-controller.js?v=10"></script>
</body>

</html>